<Window x:Class="Auralith.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Auralith" Width="560" Height="800" MinWidth="520" MinHeight="640"
        Icon="Assets/Auralith.ico"
        Foreground="#EDEDF2" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="Window_Drop" DragEnter="Window_DragEnter"
        DragOver="Window_DragOver" DragLeave="Window_DragLeave"
        PreviewKeyDown="Window_KeyDown" WindowStyle="None" ResizeMode="CanResize"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
        AutomationProperties.Name="Auralith music player">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#FFB454"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#FFD9A0"/>
        <SolidColorBrush x:Key="Muted" Color="#8E8E9E"/>
        <SolidColorBrush x:Key="Dim" Color="#5C5C6E"/>
        <SolidColorBrush x:Key="Stroke" Color="#2A2A38"/>
        <SolidColorBrush x:Key="SharedChip" Color="#16241C"/>
        <SolidColorBrush x:Key="SharedDot" Color="#4ADE80"/>
        <SolidColorBrush x:Key="ExclusiveChip" Color="#2A2012"/>

        <LinearGradientBrush x:Key="AccentGrad" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFC85A" Offset="0"/>
            <GradientStop Color="#FF8A5B" Offset="0.55"/>
            <GradientStop Color="#FF5F8B" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ArtGrad" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#3A2A12" Offset="0"/>
            <GradientStop Color="#4A1F2E" Offset="0.5"/>
            <GradientStop Color="#241A45" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#221B12"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFD9A0"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#221B12"/>

        <!-- Animated brand equalizer -->
        <Storyboard x:Key="LogoEq">
            <DoubleAnimation Storyboard.TargetName="Bar1" Storyboard.TargetProperty="Height"
                             From="5" To="15" Duration="0:0:0.46" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Bar2" Storyboard.TargetProperty="Height"
                             From="15" To="6" Duration="0:0:0.63" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Bar3" Storyboard.TargetProperty="Height"
                             From="8" To="16" Duration="0:0:0.55" AutoReverse="True" RepeatBehavior="Forever"/>
        </Storyboard>

        <Storyboard x:Key="GlowPulse">
            <DoubleAnimation Storyboard.TargetName="PlayGlow" Storyboard.TargetProperty="Opacity"
                             From="0.18" To="0.55" Duration="0:0:1.4" AutoReverse="True" RepeatBehavior="Forever"/>
        </Storyboard>

        <!-- Title-bar buttons -->
        <Style x:Key="WindowBtn" TargetType="Button">
            <Setter Property="Width" Value="40"/><Setter Property="Height" Value="30"/>
            <Setter Property="Foreground" Value="#C9C9D6"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#262634"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Background" Value="#323244"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseBtn" TargetType="Button" BasedOn="{StaticResource WindowBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#C42B1C"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Background" Value="#A82417"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Round icon buttons -->
        <Style x:Key="IconBtn" TargetType="ButtonBase">
            <Setter Property="Width" Value="42"/><Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#B9B9C8"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="b" Background="Transparent" CornerRadius="13">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#22222E"/>
                                <Setter Property="Foreground" Value="#F2F2F7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Background" Value="#2C2C3C"/></Trigger>
                            <Trigger Property="ToggleButton.IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                <Setter TargetName="b" Property="Background" Value="#251D10"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pill buttons / toggles -->
        <Style x:Key="Pill" TargetType="ButtonBase">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#B9B9C8"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="b" CornerRadius="14" Background="#17171F" BorderBrush="#2A2A38"
                                BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="#6B4A1F"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentSoft}"/>
                            </Trigger>
                            <Trigger Property="ToggleButton.IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#2A2012"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#7A5522"/>
                                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Hero play button -->
        <Style x:Key="PlayButton" TargetType="Button">
            <Setter Property="Width" Value="62"/><Setter Property="Height" Value="62"/>
            <Setter Property="Foreground" Value="#1B1206"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="disc" CornerRadius="31" Background="{StaticResource AccentGrad}"
                                BorderBrush="#40FFFFFF" BorderThickness="1" RenderTransformOrigin="0.5,0.5">
                            <Border.Effect>
                                <DropShadowEffect Color="#FF7A59" BlurRadius="22" ShadowDepth="0" Opacity="0.55"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="disc" Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="1.06" ScaleY="1.06"/></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="disc" Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="0.95" ScaleY="0.95"/></Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Horizontal seek / volume slider -->
        <Style x:Key="SeekStyle" TargetType="Slider">
            <Setter Property="Height" Value="22"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="#242432" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="{StaticResource AccentGrad}" VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="16" Height="16" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid>
                                                    <Ellipse Fill="#0B0B10" Width="16" Height="16"/>
                                                    <Ellipse Fill="{StaticResource Accent}" Width="10" Height="10"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VolStyle" TargetType="Slider" BasedOn="{StaticResource SeekStyle}">
            <Setter Property="Height" Value="18"/>
        </Style>

        <!-- Vertical EQ slider -->
        <Style x:Key="EqStyle" TargetType="Slider">
            <Setter Property="Orientation" Value="Vertical"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Width="20" Height="{TemplateBinding Height}">
                            <Border Width="4" CornerRadius="2" Background="#242432" HorizontalAlignment="Center"/>
                            <Track x:Name="PART_Track" Orientation="Vertical">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Width="4" CornerRadius="2" Background="{StaticResource AccentGrad}" HorizontalAlignment="Center"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="16" Height="10" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="5" Background="#0B0B10" BorderBrush="{StaticResource Accent}" BorderThickness="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Queue rows -->
        <Style x:Key="QueueItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="b" Background="Transparent" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="bar" Width="3" Height="18" CornerRadius="1.5"
                                        Background="{StaticResource AccentGrad}" HorizontalAlignment="Left"
                                        VerticalAlignment="Center" Opacity="0"/>
                                <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1B1B26"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#221B12"/>
                                <Setter TargetName="bar" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slim scrollbar -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True"
                                   Maximum="{TemplateBinding Maximum}" Minimum="{TemplateBinding Minimum}"
                                   Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="24">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#3A3A4C" CornerRadius="4" Margin="1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0A0A0F" Offset="0"/>
                <GradientStop Color="#11111A" Offset="0.55"/>
                <GradientStop Color="#0B0B11" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Aurora glows -->
        <Ellipse Width="360" Height="360" HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-190,-120,0" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#33FF8A5B" Offset="0"/>
                    <GradientStop Color="#00FF5F8B" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="300" Height="300" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                 Margin="-130,0,0,-160" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#248B7BFF" Offset="0"/>
                    <GradientStop Color="#008B7BFF" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Background="#08080C">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Grid Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Rectangle x:Name="Bar1" Width="3" Height="8" RadiusX="1.5" RadiusY="1.5"
                                   Fill="{StaticResource AccentGrad}" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                        <Rectangle x:Name="Bar2" Width="3" Height="14" RadiusX="1.5" RadiusY="1.5"
                                   Fill="{StaticResource AccentGrad}" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
                        <Rectangle x:Name="Bar3" Width="3" Height="6" RadiusX="1.5" RadiusY="1.5"
                                   Fill="{StaticResource AccentGrad}" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                    </Grid>
                    <TextBlock Text="AURALITH" FontSize="12" FontWeight="Bold" Foreground="#F2F2F7" VerticalAlignment="Center"/>
                    <Border Background="#1A1A24" CornerRadius="7" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="HI-FI" FontSize="8" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button x:Name="MinBtn" Content="&#xE921;" Style="{StaticResource WindowBtn}"
                            ToolTip="Minimize" AutomationProperties.Name="Minimize" Click="Min_Click"/>
                    <Button x:Name="MaxBtn" Content="&#xE922;" Style="{StaticResource WindowBtn}"
                            ToolTip="Maximize" AutomationProperties.Name="Maximize" Click="Max_Click"/>
                    <Button x:Name="CloseBtn" Content="&#xE8BB;" Style="{StaticResource CloseBtn}"
                            ToolTip="Close" AutomationProperties.Name="Close" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <!-- Now playing -->
            <Border Grid.Row="1" Margin="18,12,18,4" Padding="16" CornerRadius="18" BorderThickness="1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1B1B26" Offset="0"/>
                        <GradientStop Color="#13131C" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#3A3A4C" Offset="0"/>
                        <GradientStop Color="#1E1E29" Offset="1"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="112"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Width="112" Height="112">
                        <Border CornerRadius="16" Background="{StaticResource ArtGrad}">
                            <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="42"
                                       Foreground="#B3FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Rectangle Width="112" Height="112" RadiusX="16" RadiusY="16">
                            <Rectangle.Fill>
                                <ImageBrush x:Name="ArtBrush" Stretch="UniformToFill"/>
                            </Rectangle.Fill>
                            <Rectangle.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="5" Opacity="0.5"/>
                            </Rectangle.Effect>
                        </Rectangle>
                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="8"
                                Background="#B3000000" CornerRadius="6" Padding="6,2">
                            <TextBlock x:Name="QualityText" Text="HI-FI" FontSize="8" FontWeight="Bold" Foreground="#FFD9A0"/>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="NOW PLAYING" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
                        <TextBlock x:Name="TitleText" Text="Nothing playing" FontSize="19" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                        <TextBlock x:Name="ArtistText" Text="Add or drop music to begin" FontSize="12"
                                   Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                        <TextBlock x:Name="AlbumText" Text="" FontSize="10" Foreground="{StaticResource Dim}"
                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>

                        <Grid Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                <TextBlock x:Name="TimeText" Text="00:00" FontFamily="Consolas" FontSize="23"
                                           Foreground="{StaticResource Accent}"/>
                                <TextBlock x:Name="DurationText" Text=" / 00:00" FontFamily="Consolas" FontSize="11"
                                           Foreground="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="2,0,0,3"/>
                            </StackPanel>
                            <Border x:Name="ModeChip" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Background="{StaticResource SharedChip}" CornerRadius="9" Padding="8,3">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="ModeDot" Width="6" Height="6" Fill="{StaticResource SharedDot}"
                                             VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock x:Name="ModeText" Text="SHARED" FontSize="9" FontWeight="SemiBold"
                                               Foreground="{StaticResource SharedDot}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Seek -->
            <Slider x:Name="Seek" Grid.Row="2" Margin="22,10,22,2" Minimum="0" Maximum="1"
                    IsMoveToPointEnabled="True" Style="{StaticResource SeekStyle}"
                    ValueChanged="Seek_ValueChanged" ToolTip="Seek" AutomationProperties.Name="Seek"/>

            <!-- Transport -->
            <Grid Grid.Row="3" Margin="18,0,18,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="70"/>
                    <RowDefinition Height="26"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0,0,0">
                        <ToggleButton x:Name="ShuffleBtn" Content="&#xE8B1;" Style="{StaticResource IconBtn}"
                                      ToolTip="Shuffle" AutomationProperties.Name="Shuffle"/>
                        <ToggleButton x:Name="RepeatBtn" Content="&#xE8EE;" Style="{StaticResource IconBtn}"
                                      ToolTip="Repeat: off" AutomationProperties.Name="Repeat" Click="Repeat_Click"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button Content="&#xE892;" Style="{StaticResource IconBtn}" ToolTip="Previous"
                                AutomationProperties.Name="Previous" Click="Prev_Click"/>
                        <Grid Margin="12,0">
                            <Border x:Name="PlayGlow" Width="70" Height="70" CornerRadius="35"
                                    Background="{StaticResource AccentGrad}" Opacity="0.18" IsHitTestVisible="False">
                                <Border.Effect><BlurEffect Radius="20" KernelType="Gaussian"/></Border.Effect>
                            </Border>
                            <Button x:Name="PlayBtn" Content="&#xE768;" Style="{StaticResource PlayButton}"
                                    ToolTip="Play / Pause" AutomationProperties.Name="Play or pause" Click="Play_Click"/>
                        </Grid>
                        <Button Content="&#xE893;" Style="{StaticResource IconBtn}" ToolTip="Next"
                                AutomationProperties.Name="Next" Click="Next_Click"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
                        <Button Content="&#xE71A;" Style="{StaticResource IconBtn}" ToolTip="Stop"
                                AutomationProperties.Name="Stop" Click="Stop_Click"/>
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                               Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <Slider x:Name="Vol" Width="150" Minimum="0" Maximum="1" Value="0.8" Margin="8,0,8,0"
                            Style="{StaticResource VolStyle}" ValueChanged="Vol_ValueChanged"
                            ToolTip="Volume" AutomationProperties.Name="Volume"/>
                    <TextBlock x:Name="VolText" Text="80" FontSize="10" FontFamily="Consolas"
                               Foreground="{StaticResource Muted}" Width="24" TextAlignment="Right" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- Toolbar -->
            <Grid Grid.Row="4" Margin="18,8,18,8">
                <StackPanel Orientation="Horizontal">
                    <Button Content="+  Add" Style="{StaticResource Pill}" Click="Add_Click"
                            ToolTip="Add files (Ctrl+O)" AutomationProperties.Name="Add files"/>
                    <Button Content="Clear" Style="{StaticResource Pill}" Click="Clear_Click"
                            AutomationProperties.Name="Clear playlist"/>
                    <ToggleButton x:Name="EqBtn" Content="EQ" Style="{StaticResource Pill}" Click="Eq_Click"
                                  AutomationProperties.Name="Equalizer"/>
                    <ToggleButton x:Name="ExclBtn" Content="Exclusive" Style="{StaticResource Pill}" Click="Excl_Click"
                                  AutomationProperties.Name="WASAPI exclusive mode"
                                  ToolTip="WASAPI exclusive: bit-perfect output that bypasses the Windows mixer"/>
                </StackPanel>
                <TextBlock x:Name="QueueText" HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
            </Grid>

            <!-- Queue -->
            <Border Grid.Row="5" Margin="18,0,18,14" Background="#0F0F16" CornerRadius="16"
                    BorderBrush="#232332" BorderThickness="1" Padding="6">
                <Grid>
                    <ListBox x:Name="PlaylistBox" Background="Transparent" BorderThickness="0"
                             Foreground="#EDEDF2" MouseDoubleClick="Playlist_DoubleClick"
                             ItemContainerStyle="{StaticResource QueueItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="Playlist">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="14" Height="14" VerticalAlignment="Center">
                                        <StackPanel x:Name="bars" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                                            <Rectangle Width="2.5" Height="6" RadiusX="1" RadiusY="1"
                                                       Fill="{StaticResource Accent}" Margin="0,0,1.5,0"/>
                                            <Rectangle Width="2.5" Height="11" RadiusX="1" RadiusY="1"
                                                       Fill="{StaticResource Accent}" Margin="0,0,1.5,0"/>
                                            <Rectangle Width="2.5" Height="8" RadiusX="1" RadiusY="1"
                                                       Fill="{StaticResource Accent}"/>
                                        </StackPanel>
                                        <Ellipse x:Name="dot" Width="5" Height="5" Fill="{StaticResource Dim}" VerticalAlignment="Center"/>
                                    </Grid>
                                    <StackPanel Grid.Column="1" Margin="6,0,12,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="itemTitle" Text="{Binding Title}" FontSize="12.5"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Artist}" FontSize="10.5" Foreground="{StaticResource Muted}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontFamily="Consolas"
                                               FontSize="10.5" Foreground="{StaticResource Dim}" VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                        <Setter TargetName="bars" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="dot" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="itemTitle" Property="Foreground" Value="{StaticResource Accent}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsHitTestVisible="False" Visibility="Visible">
                        <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="38"
                                   Foreground="#333342" HorizontalAlignment="Center"/>
                        <TextBlock Text="Your queue is empty" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#6E6E82" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                        <TextBlock Text="Drop files or folders, or press + Add" FontSize="11"
                                   Foreground="#4C4C5E" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Equalizer -->
            <Border x:Name="EqPanel" Grid.Row="6" Visibility="Collapsed" Margin="18,0,18,14"
                    Background="#0F0F16" CornerRadius="16" BorderBrush="#232332" BorderThickness="1" Padding="12,10">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="10-BAND EQUALIZER" FontSize="9" FontWeight="SemiBold"
                                   Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                        <Button Content="Reset" Style="{StaticResource Pill}" Height="24" HorizontalAlignment="Right"
                                Click="EqReset_Click" AutomationProperties.Name="Reset equalizer"/>
                    </Grid>
                    <UniformGrid x:Name="EqGrid" Rows="1" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Drag & drop overlay -->
        <Border x:Name="DropOverlay" Visibility="Collapsed" Margin="12" CornerRadius="20"
                Background="#E60B0B10" BorderBrush="{StaticResource Accent}" BorderThickness="2"
                IsHitTestVisible="False">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="44"
                           Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
                <TextBlock Text="Drop to add music" FontSize="17" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,10,0,0"/>
                <TextBlock Text="Files and folders are supported" FontSize="11" Foreground="{StaticResource Muted}"
                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
