<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Auralith" Manufacturer="Auralith" Version="1.0.0"
           UpgradeCode="C5EC1FDC-13D9-46E7-A612-9E3D58D39F34" Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Auralith is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="..\src\Assets\Auralith.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Auralith" />
    </StandardDirectory>

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(PublishDir)\**" />
    </ComponentGroup>

    <Component Id="StartMenuShortcut" Directory="ProgramMenuFolder">
      <Shortcut Id="AppShortcut" Name="Auralith" Target="[INSTALLFOLDER]Auralith.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
      <RegistryValue Root="HKCU" Key="Software\Auralith" Name="Shortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Feature Id="Main" Title="Auralith" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Package>
</Wix>
